Log {
    border: solid $primary;
}

#left_panel,#right_panel {
    border: solid $primary;
    layout: grid;
    grid-size: 2;
    height: 15;
}

#categories {
    column-span: 2;
}

Log {
    text-wrap: wrap; 
}

#recipes_container {
    height: 60;
    layout: grid;
    grid-size: 2;
    border: solid $primary;
}

Switch {
    border: none;
} 