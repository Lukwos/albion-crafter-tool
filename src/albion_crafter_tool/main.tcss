Log {
    border: solid green;
}

#left_panel,#right_panel {
    border: solid blue;
    layout: grid;
    grid-size: 2;
    height: auto;
}

#categories {
    column-span: 2;
}

Log {
    text-wrap: wrap; 
}

#recipes_container {
    height: 60;
    layout: grid;
    grid-size: 2;
    border: solid red;
}